  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=10"
  },
  "devDependencies": {
    "@types/eslint": "9.6.1",
    "@types/node": "24.19.1",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "concurrently": "10.0.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "config": "5.0.1",
    "dd-trace": "6.19.0",
